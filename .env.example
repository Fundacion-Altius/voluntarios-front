NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IMAGE_PREFIX=/
# Central Auth Host for OAuth callbacks
# For local development: http://localhost:3000
# For production: https://auth.klaruk.com
# Azure AD requires exact redirect URI matches - register this URL in Azure portal
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
# OAuth (Doppler). No NEXT_PUBLIC_* needed — login reads these on the server.
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service worker: register in development (offline survey / cache testing).
# Always registered in production regardless of this flag.
NEXT_PUBLIC_ENABLE_SW=false

# Video conferencing (TURN/STUN for WebRTC)
ENABLE_VIDEO=false
NEXT_PUBLIC_TURN_HOST=localhost
NEXT_PUBLIC_TURN_PORT=3478
NEXT_PUBLIC_TURN_USERNAME=voluntarios
NEXT_PUBLIC_TURN_PASSWORD=your-turn-password
NEXT_PUBLIC_TURN_REALM=your-turn-realm

# Optional: overrides the WS origin used by realtime notifications/chat
# (path /ws is appended). If unset, the client derives wss://<API host>/ws
# from NEXT_PUBLIC_API_URL. Do not point this at the Next/Vercel front —
# Vercel has no /ws. Set this when the API URL is an internal address
# (e.g. localhost in an nginx same-host deploy) but browsers need the
# public backend origin.
NEXT_PUBLIC_WS_BASE_URL=
