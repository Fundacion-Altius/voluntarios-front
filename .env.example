NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IMAGE_PREFIX=/
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
NEXT_PUBLIC_AZURE_AD_ENABLED=true

# Video conferencing (TURN/STUN for WebRTC)
ENABLE_VIDEO=false
NEXT_PUBLIC_TURN_HOST=localhost
NEXT_PUBLIC_TURN_PORT=3478
NEXT_PUBLIC_TURN_USERNAME=voluntarios
NEXT_PUBLIC_TURN_PASSWORD=your-turn-password
NEXT_PUBLIC_TURN_REALM=your-turn-realm

# Optional: overrides the WS base URL used by realtime notifications and
# mediasoup video signaling. Set this when frontend and backend are
# reachable at two different origins with no reverse proxy between them
# (e.g. two separate ngrok tunnels for cross-device testing). Leave unset
# for local single-origin dev and for production, where the existing
# hostname-based derivation and nginx proxy already handle it.
NEXT_PUBLIC_WS_BASE_URL=
